<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Primary Hardware-Accelerated WebView for Leaflet Radar -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Error / Offline Fallback Overlay -->
    <LinearLayout
        android:id="@+id/error_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_title"
            android:textColor="@color/radar_amber"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_detail"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/error_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:text="@string/btn_retry"
                android:textColor="@color/text_primary"
                android:background="#1E293B"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_config_url"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:text="@string/btn_configure"
                android:textColor="@color/text_primary"
                android:background="#2563EB"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Remote Control Toast Hint Banner (hidden to avoid overlapping Leaflet HUD) -->
    <TextView
        android:id="@+id/remote_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#CC0B0F19"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Remote: D-Pad Pan • Center Select • Play/Pause Home • Menu/Info Server URL"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</FrameLayout>
